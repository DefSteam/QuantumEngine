# Only the app (quantum-linux/) is versioned.

# Research notes, captures and tools stay local.
/reverse engineer/

# Logs
*.log

# Rust build output (quantum-linux/.gitignore covers it too, for when that
# folder is published as its own repo)
target/

# Python
__pycache__/
*.py[cod]
.venv/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# Arch packages and makepkg leftovers (the release workflow builds and
# publishes the packages; they never belong in the repo)
*.pkg.tar.zst
*.pkg.tar.zst.sig
*.pkg.tar.zst.sha256
quantum-linux/packaging/src/
quantum-linux/packaging/pkg/
quantum-linux/packaging/*.tar.gz
